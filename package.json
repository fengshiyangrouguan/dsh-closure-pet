{
  "name": "dsh-closure-pet",
  "version": "1.0.0",
  "description": "可露希尔桌宠：豪堪小动画、余额与花费提示",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./icon": "./icon.png",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "icon": "./icon.png",
  "files": [
    "locale",
    "lib",
    "assets",
    "tests",
    "client.js",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node --check lib/index.js && node --check client.js && node --check assets/src/main.js && node --check assets/pet.js"
  },
  "keywords": [
    "dsh-plugin",
    "desktop-pet",
    "spine",
    "arknights",
    "closure",
    "pixel-art"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengshiyangrouguan/dsh-closure-pet.git"
  },
  "homepage": "https://github.com/fengshiyangrouguan/dsh-closure-pet#readme",
  "bugs": {
    "url": "https://github.com/fengshiyangrouguan/dsh-closure-pet/issues"
  },
  "license": "MIT",
  "author": "FSYRG"
}

